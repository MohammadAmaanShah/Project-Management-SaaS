# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://pm:pm@localhost:5432/pm?schema=public"

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────
JWT_ACCESS_SECRET=changeme_access_secret_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme_refresh_secret_min32chars
JWT_REFRESH_EXPIRES_IN=7d

# ── App ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── Mail (Mailpit dev SMTP) ────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="PM SaaS <noreply@pm-saas.local>"

# ── Frontend (Next.js) ────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api
